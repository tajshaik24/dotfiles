# Short commands (ll, gst, md, 1-9, brewup, ...) are tcomp abbreviations in
# tcomp/abbr.tsv: they expand to the full command when you press Enter or Tab.
# This file keeps what abbreviations can't do.

# Stage all dotfile changes and show what would be committed.
sync_dotfiles() {
  (
    cd ~/Developer/dotfiles || return
    git add -A
    git status
    echo ""
    echo "Ready to commit changes. Run:"
    echo "  cd ~/Developer/dotfiles"
    echo "  git commit -m 'your message'"
    echo "  git push"
  )
}

# Directory stack: every cd is remembered (jump back with -, 1-9).
setopt auto_pushd
setopt pushd_ignore_dups
setopt pushdminus

# Global aliases expand anywhere in a line: cd ..., ls ..../src
alias -g ...='../..'
alias -g ....='../../..'
alias -g .....='../../../..'
alias -g ......='../../../../..'
