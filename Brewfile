# Brewfile — install everything this shell config depends on:
#   brew bundle --file=~/Developer/dotfiles/Brewfile
#
# Safe to run repeatedly; brew skips anything already installed.

# zsh extensions that power the interactive prompt (sourced from zshrc)
brew "zsh-autocomplete"
brew "zsh-syntax-highlighting"

# Terminal emulator (uses ghostty.config from this repo)
cask "ghostty"
