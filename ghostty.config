# Font
font-size = 14
# True color support
term = xterm-256color
# Cursor
cursor-style = block
cursor-style-blink = false
# Window padding
window-padding-x = 4
window-padding-y = 4
# Colors (Terminal.app Clear Dark)
foreground = #ffffff
background = #111111
palette = 0=#000000
palette = 1=#bb0000
palette = 2=#00bb00
palette = 3=#bbbb00
palette = 4=#2472c8
palette = 5=#bb00bb
palette = 6=#00bbbb
palette = 7=#ffffff
palette = 8=#555555
palette = 9=#ff5555
palette = 10=#55ff55
palette = 11=#ffff55
palette = 12=#5555ff
palette = 13=#ff55ff
palette = 14=#55ffff
palette = 15=#ffffff
